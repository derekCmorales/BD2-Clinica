# Copiar a .env antes de levantar Compose (scripts/preparar-entorno.sh lo hace por ti).
# Valores de laboratorio académico; no son secretos de producción.

# --- PostgreSQL · Hospital general
POSTGRES_HOST=localhost
# Puertos de host fuera de los default (5432, 3306, 27017, 6379): si hay motores instalados
# en el host (Homebrew, Postgres.app), "localhost:<default>" llegaría a ellos y no al contenedor, sin error.
POSTGRES_PORT=5433
POSTGRES_DB=hospital
# Usuario de aplicación (privilegios mínimos). El superusuario solo lo usan migraciones/seeds.
POSTGRES_USER=hospital_app
POSTGRES_PASSWORD=hospital_app_dev
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERPASS=postgres_dev

# --- MySQL · Clínica odontológica
MYSQL_HOST=localhost
MYSQL_PORT=3307
MYSQL_DATABASE=odontologia
MYSQL_USER=odontologia_app
MYSQL_PASSWORD=odontologia_app_dev
MYSQL_ROOT_PASSWORD=mysql_root_dev

# --- MongoDB · Laboratorio clínico
MONGO_HOST=localhost
MONGO_PORT=27018
MONGO_DATABASE=laboratorio
MONGO_USER=laboratorio_app
MONGO_PASSWORD=laboratorio_app_dev
MONGO_INITDB_ROOT_USERNAME=mongo_root
MONGO_INITDB_ROOT_PASSWORD=mongo_root_dev
# directConnection=true: el replica set anuncia "mongo:27017", que no resuelve desde el host.
MONGO_URI=mongodb://laboratorio_app:laboratorio_app_dev@localhost:27018/laboratorio?authSource=laboratorio&directConnection=true

# --- Redis · Centro pediátrico (sistema de registro, AOF + RDB)
REDIS_PEDIATRICO_HOST=localhost
REDIS_PEDIATRICO_PORT=6390
REDIS_PEDIATRICO_USER=pediatrico_app
REDIS_PEDIATRICO_PASSWORD=pediatrico_app_dev
# Solo para operación (scripts, inspección). La app nunca lo usa.
REDIS_ADMIN_USER=redis_admin
REDIS_ADMIN_PASSWORD=redis_admin_dev

# --- Redis · Caché transversal (volátil, sin persistencia)
REDIS_CACHE_HOST=localhost
REDIS_CACHE_PORT=6391
REDIS_CACHE_USER=cache_app
REDIS_CACHE_PASSWORD=cache_app_dev
REDIS_CACHE_MAXMEMORY=128mb

# --- API
API_PORT=3000
WEB_ORIGIN=http://localhost:5173
# memoria: los cuatro adaptadores en proceso, sin Docker.
# motores: Postgres, MySQL, Mongo y Redis del compose.
PERSISTENCIA=memoria
JWT_SECRET=jwt_dev_cambiar
DEMO_CLAVE=demo
